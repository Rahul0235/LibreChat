{
  "openapi": "3.0.0",
  "info": {
    "title": "Contact Lookup",
    "description": "Search and query the user's contacts database",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3080" }
  ],
  "paths": {
    "/api/contacts/lookup": {
      "post": {
        "operationId": "lookupContacts",
        "summary": "Search contacts by company, role, name, or keyword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["text", "company", "role", "name", "attribute", "all"],
                    "description": "Search type"
                  },
                  "query": {
                    "type": "string",
                    "description": "Search query (for text/company/role/name)"
                  },
                  "key": {
                    "type": "string",
                    "description": "Attribute key (for attribute search)"
                  },
                  "value": {
                    "type": "string",
                    "description": "Attribute value (for attribute search)"
                  },
                  "limit": {
                    "type": "integer",
                    "default": 10
                  }
                },
                "required": ["type"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of matching contacts"
          }
        }
      }
    },
    "/api/contacts/lookup/stats": {
      "get": {
        "operationId": "contactStats",
        "summary": "Get stats about the contacts database",
        "responses": {
          "200": {
            "description": "Contact database statistics"
          }
        }
      }
    }
  }
}